<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Keluarga Material (Material Family) -->
        <record id="family_carbon_steel" model="tpr.material.family">
            <field name="name">Baja Karbon (Carbon Steel)</field>
            <field name="code">CS</field>
            <field name="density">7.85</field>
            <field name="description">Baja karbon struktural untuk fabrikasi umum (Pelat Hitam / Mild Steel)</field>
        </record>

        <record id="family_stainless_steel" model="tpr.material.family">
            <field name="name">Baja Tahan Karat (Stainless Steel)</field>
            <field name="code">SS</field>
            <field name="density">7.93</field>
            <field name="description">Austenitic Stainless Steel untuk aplikasi tahan korosi</field>
        </record>

        <record id="family_aluminium" model="tpr.material.family">
            <field name="name">Aluminium Alloy</field>
            <field name="code">AL</field>
            <field name="density">2.70</field>
            <field name="description">Paduan aluminium lembaran ringan</field>
        </record>

        <!-- Grade Material -->
        <record id="grade_ss400" model="tpr.material.grade">
            <field name="name">SS400</field>
            <field name="family_id" ref="family_carbon_steel"/>
            <field name="standard_spec">JIS G 3101</field>
            <field name="description">Material standar pelat fabrikasi struktural CV TPR</field>
        </record>

        <record id="grade_a36" model="tpr.material.grade">
            <field name="name">A36</field>
            <field name="family_id" ref="family_carbon_steel"/>
            <field name="standard_spec">ASTM A36 / A36M</field>
            <field name="description">Baja struktural karbon standar ASTM</field>
        </record>

        <record id="grade_sus304" model="tpr.material.grade">
            <field name="name">SUS304</field>
            <field name="family_id" ref="family_stainless_steel"/>
            <field name="standard_spec">JIS G 4305 / ASTM A240</field>
            <field name="description">Stainless steel tipe 304 food/chemical grade</field>
        </record>

        <!-- Ketebalan Pelat Nominal (mm) -->
        <record id="thickness_3mm" model="tpr.material.thickness">
            <field name="value">3.0</field>
            <field name="unit">mm</field>
            <field name="description">Tebal 3.0 mm</field>
        </record>
        <record id="thickness_4mm" model="tpr.material.thickness">
            <field name="value">4.0</field>
            <field name="unit">mm</field>
            <field name="description">Tebal 4.0 mm</field>
        </record>
        <record id="thickness_5mm" model="tpr.material.thickness">
            <field name="value">5.0</field>
            <field name="unit">mm</field>
            <field name="description">Tebal 5.0 mm</field>
        </record>
        <record id="thickness_6mm" model="tpr.material.thickness">
            <field name="value">6.0</field>
            <field name="unit">mm</field>
            <field name="description">Tebal 6.0 mm</field>
        </record>
        <record id="thickness_8mm" model="tpr.material.thickness">
            <field name="value">8.0</field>
            <field name="unit">mm</field>
            <field name="description">Tebal 8.0 mm</field>
        </record>
        <record id="thickness_10mm" model="tpr.material.thickness">
            <field name="value">10.0</field>
            <field name="unit">mm</field>
            <field name="description">Tebal 10.0 mm</field>
        </record>
        <record id="thickness_12mm" model="tpr.material.thickness">
            <field name="value">12.0</field>
            <field name="unit">mm</field>
            <field name="description">Tebal 12.0 mm</field>
        </record>
        <record id="thickness_16mm" model="tpr.material.thickness">
            <field name="value">16.0</field>
            <field name="unit">mm</field>
            <field name="description">Tebal 16.0 mm</field>
        </record>
    </data>
</odoo>
