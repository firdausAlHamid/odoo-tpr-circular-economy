<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Module Privilege -->
    <record id="res_groups_privilege_waste" model="res.groups.privilege">
        <field name="name">TPR Waste Management</field>
        <field name="description">Pengelolaan dan inspeksi sisa material sirkular CV TPR</field>
        <field name="sequence">25</field>
    </record>

    <!-- Groups -->
    <record id="group_tpr_waste_user" model="res.groups">
        <field name="name">Petugas Pencatat Waste</field>
        <field name="privilege_id" ref="res_groups_privilege_waste"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Dapat mencatat sisa potongan, dimensi, berat, dan mengajukan ke karantina.</field>
    </record>

    <record id="group_tpr_waste_manager" model="res.groups">
        <field name="name">Penanggung Jawab / Inspector</field>
        <field name="privilege_id" ref="res_groups_privilege_waste"/>
        <field name="implied_ids" eval="[(4, ref('group_tpr_waste_user'))]"/>
        <field name="comment">Berwenang melakukan inspeksi dan menetapkan kelayakan Reusable atau Scrap fisik.</field>
    </record>

    <data noupdate="1">
        <!-- Multi-Company Rule -->
        <record id="tpr_remnant_cut_company_rule" model="ir.rule">
            <field name="name">Remnant Cut Multi-Company</field>
            <field name="model_id" ref="model_tpr_remnant_cut"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
