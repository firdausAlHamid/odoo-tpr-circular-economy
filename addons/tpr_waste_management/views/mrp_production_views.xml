<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_inherit_waste" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.waste</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_remnant_cuts"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-recycle">
                    <field name="remnant_count" widget="statinfo" string="Sisa Potongan"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
